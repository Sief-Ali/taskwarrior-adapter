{
  "name": "taskwarrior-adapter",
  "version": "0.2.5",
  "description": "A small, typed Node.js adapter for the Taskwarrior CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sief-Ali/taskwarrior-adapter.git"
  },
  "homepage": "https://github.com/Sief-Ali/taskwarrior-adapter#readme",
  "bugs": {
    "url": "https://github.com/Sief-Ali/taskwarrior-adapter/issues"
  },
  "keywords": [
    "taskwarrior",
    "taskwarrior-cli",
    "task-management",
    "typescript",
    "cli-adapter"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "example:read": "tsx examples/read-tasks.ts",
    "example:get-task": "tsx examples/get-task.ts",
    "example:query": "tsx examples/query-tasks.ts",
    "example:create": "tsx examples/create-task.ts",
    "example:modify": "tsx examples/modify-task.ts",
    "example:complete": "tsx examples/complete-task.ts",
    "example:delete": "tsx examples/delete-task.ts",
    "example:configured": "tsx examples/configured-client.ts",
    "example:custom-attributes": "tsx examples/read-custom-attributes.ts",
    "example:errors": "tsx examples/handle-errors.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
