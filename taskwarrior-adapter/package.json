{
  "name": "taskwarrior-cli-adapter",
  "version": "0.1.0",
  "description": "A typed, framework-independent Node.js adapter for the Taskwarrior CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "example:read": "tsx examples/read-tasks.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "taskwarrior",
    "taskwarrior-cli",
    "todo",
    "tasks",
    "task-management",
    "nodejs",
    "typescript",
    "cli",
    "adapter"
  ],
  "sideEffects": false
}
